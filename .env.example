# ==============================================================================
# ZAtax Compliance Advisor - Environment Configuration (.env.example)
# Target Environment: Local Sandbox & Testing
# ==============================================================================

# 1. Application & Tax Engine Settings
# TAX_ENV: "sandbox" for development/mocking, "production" for real SARS filing
TAX_ENV="sandbox"

# SARS_SIMULATION: Set to "true" in sandbox to mock external SARS GovTech gateway calls
SARS_SIMULATION="true"

# 2. SARS eFiling & Gateway Integration Endpoints
# SARS_API_ENDPOINT: Target REST ingress endpoint for third-party submissions
SARS_API_ENDPOINT="https://sandbox.sars.gov.za/api/v1"

# SARS_EDI_HOST: GovTech EDI / Sterling File Gateway hostname
SARS_EDI_HOST="edi-sandbox.sars.gov.za"

# SARS_EDI_PORT: EDI TCP port (443 for HTTPS/TLS, 1364 for Connect:Direct)
SARS_EDI_PORT="443"

# 3. Gateway Authentication Credentials (replaces duplicated simulation key)
# SARS_API_KEY: ISV Third-Party Data submission API key (Header: X-SARS-Api-Key)
SARS_API_KEY="sandbox_isv_key_mock_9304318273"

# SARS_CLIENT_SECRET: Optional OAuth 2.0 / Mutual TLS client secret
SARS_CLIENT_SECRET="mock_isv_client_secret_994821"

# SARS_CERT_PATH: Optional filesystem path to client X.509 certificate for mTLS
SARS_CERT_PATH="./certs/sars_sandbox_cert.pem"

# 4. System & Security Secrets
# DATABASE_URL: PostgreSQL / Cloud SQL connection string
DATABASE_URL="postgresql://sars_user:secure_password@localhost:5432/zatax_db"

# SESSION_SECRET: High-entropy secret string used to sign session bearer tokens
SESSION_SECRET="your_generated_random_secret_string_here"

# POPIA Section 19 Cryptographic Keys (AES-256-GCM for PII at rest)
POPIA_ENCRYPTION_KEY="your-32-byte-encryption-secret-here"
AES_KEY="your-32-byte-aes-gcm-master-key-here"

# 5. Hosting & AI Studio Platform Settings
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://ilitha.co.za"
GITHUB_REPO="Thato-Tha/Tax-Compliance-Advisor"

